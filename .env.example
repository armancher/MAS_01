# Copy to .env and fill in ONE backend. Never commit .env.

# Gemini (key from Google AI Studio)
LLM_BACKEND=gemini
GEMINI_API_KEY=
LLM_MODEL=

# Qwen via Alibaba Model Studio (international / Singapore region)
# LLM_BACKEND=qwen
# DASHSCOPE_API_KEY=
# LLM_MODEL=qwen-plus
# Other regions: LLM_BASE_URL=https://dashscope-us.aliyuncs.com/compatible-mode/v1

# Qwen locally via Ollama (free, no key): `ollama pull qwen3` first
# LLM_BACKEND=ollama
# LLM_MODEL=qwen3

# Optional: less "thinking" on reasoning models (cheaper, faster)
# LLM_REASONING_EFFORT=low
